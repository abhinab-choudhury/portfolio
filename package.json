{
  "name": "portfolio",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typegen": "turbo run typegen",
    "studio": "turbo run dev --filter=studio",
    "studio:build": "turbo run build --filter=studio",
    "studio:deploy": "turbo run deploy --filter=studio",
    "web": "turbo run dev --filter=web",
    "web:build": "turbo run build --filter=web"
  },
  "devDependencies": {
    "oxlint": "^1.71.0",
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
